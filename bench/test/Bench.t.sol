    function test_mulDiv_big() public {
        harness.mulDivNearest(123456789012345678901234567890, 987654321098765432109876543210, 1000000000000000000); // warm-up
        uint256 g = gasleft();
        uint256 r1 = harness.mulDivNearest(123456789012345678901234567890, 987654321098765432109876543210, 1000000000000000000);
        uint256 u1 = g - gasleft();
        g = gasleft();
        uint256 r2 = harness.mulDivFloor(123456789012345678901234567890, 987654321098765432109876543210, 1000000000000000000);
        uint256 u2 = g - gasleft();
        assertGe(r1, r2);
        console.log("fe mulDivNearest big gas:", u1);
        console.log("fe mulDivFloor big gas:", u2);
    }

