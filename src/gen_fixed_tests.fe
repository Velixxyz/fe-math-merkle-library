#[test]
fn sqrt_abs_0() {
    assert!(
        sqrt_abs(SWad::from_raw(-4000000000000000000)) == Wad::from_raw(2000000000000000000),
    )
}

#[test]
fn sqrt_abs_1() {
    assert!(
        sqrt_abs(SWad::from_raw(-9000000000000000000)) == Wad::from_raw(3000000000000000000),
    )
}

#[test]
fn sqrt_abs_2() {
    assert!(sqrt_abs(SWad::from_raw(0)) == Wad::from_raw(0))
}

#[test]
fn sqrt_abs_3() {
    assert!(
        sqrt_abs(SWad::from_raw(0xde0b6b3a76400000)) == Wad::from_raw(4000000000000000000),
    )
}

#[test]
fn sqrt_abs_4() {
    assert!(
        sqrt_abs(SWad::from_raw(-2000000000000000000)) == Wad::from_raw(1414213562373095048),
    )
}

#[test]
fn sqrt_abs_5() {
    assert!(
        sqrt_abs(SWad::from_raw(-1000000000000000000)) == Wad::from_raw(1000000000000000000),
    )
}

#[test]
fn sqrt_abs_6() {
    assert!(
        sqrt_abs(SWad::from_raw(0x15af1d78b58c40000)) == Wad::from_raw(5000000000000000000),
    )
}

#[test]
fn sqrt_abs_7() {
    assert!(
        sqrt_abs(SWad::from_raw(-0x6b14e9f7e4f5a5000)) == Wad::from_raw(0x9a3298a3f053e270),
    )
}

#[test]
fn vested_0() {
    assert!(vested_fraction(100, 200, 100) == Wad::from_raw(0))
}

#[test]
fn vested_1() {
    assert!(
        vested_fraction(100, 200, 200) == Wad::from_raw(1000000000000000000),
    )
}

#[test]
fn vested_2() {
    assert!(
        vested_fraction(100, 200, 150) == Wad::from_raw(500000000000000000),
    )
}

#[test]
fn vested_3() {
    assert!(vested_fraction(100, 200, 50) == Wad::from_raw(0))
}

#[test]
fn vested_4() {
    assert!(
        vested_fraction(100, 200, 250) == Wad::from_raw(1000000000000000000),
    )
}

#[test]
fn vested_5() {
    assert!(
        vested_fraction(100, 200, 133) == Wad::from_raw(330000000000000000),
    )
}

#[test]
fn vested_6() {
    assert!(
        vested_fraction(100, 100, 100) == Wad::from_raw(1000000000000000000),
    )
}

#[test]
fn vested_7() {
    assert!(
        vested_fraction(200, 100, 150) == Wad::from_raw(1000000000000000000),
    )
}

#[test]
fn vested_8() {
    assert!(
        vested_fraction(0, 0, 0) == Wad::from_raw(1000000000000000000),
    )
}

#[test]
fn vested_9() {
    assert!(
        vested_fraction(1000000, 2000000, 1500000) == Wad::from_raw(500000000000000000),
    )
}

#[test]
fn vested_10() {
    assert!(
        vested_fraction(0, 1000000000, 333333333) == Wad::from_raw(333333333000000000),
    )
}
