            message: DistributorMsg::Claim {
                proof: proof_to_dynarray(proof),
                index: 0,
                account: alice,
                amount: 250000000000000000,
            },
        )
}

#[test]
fn multiproof_dynarray_containers() {
    // The multiproof API over DynArray containers (incl. an empty proof),
    // the exact shapes the ClaimMulti handler uses.
    let root: u256 = 0x8a0793ea3c3790c59a9d8fbde3c6fb9fe6ef4f4f13b4ec0c9e02f910024c07ad
    let empty_proof = DynArray::from_slice(empty_words())
    assert!(empty_proof.len() == 0)
    let flags = bools_dyn([true, true, true])
    assert!(flags.len() == 3)
    let leaves = proof_to_dynarray(
        words(
            [
                0xe0afe6df674ec998ece90d140c5916b331289a76c258163da083e5c1c6403f7b,
                0x647dc7437e02fd27e50f72e3bb9edfb29349b80dba3beb9399e592eec7e26b50,
                0x20a62805dd7ead5ce8b3e719dfcf1e7ad3359a12dee8b37b217307b56ec032de,
                0x28333f592aaf420dc45328a4db42750e6e228bf3318ebbfcafaf9a51e6df52c3,
            ],
        ),
    )
    assert!(leaves.len() == 4)
    assert!(
        multiproof::verify_multi_proof(
            proof: empty_proof,
            proof_flags: flags,
            root: root,
            leaves: leaves,
        ),
    )
}

#[test(balance = 10_000_000_000_000_000_000)]
fn distributor_timestamp_stable_within_test() uses (evm: mut Evm) {
    let distributor = deploy_tree4(0, 1_000_000_000_000, 0, 0)
    let f1: u256 = evm
        .call(
            addr: distributor,
            gas: 100000,
            value: Wei::zero(),
            message: DistributorMsg::VestedFraction {},
        )
    let f2: u256 = evm
        .call(
            addr: distributor,
            gas: 100000,
            value: Wei::zero(),
            message: DistributorMsg::VestedFraction {},
        )
    assert!(f1 == f2)
    assert!(f1 > 0)
    assert!(f1 < Wad::SCALE)
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn distributor_fee_over_100_reverts() uses (evm: mut Evm) {
    let root: u256 = 0x8a0793ea3c3790c59a9d8fbde3c6fb9fe6ef4f4f13b4ec0c9e02f910024c07ad
    let _ = evm
        .create2<MerkleDistributor>(
            value: Wei::zero(),
            args: (root, 0, 0, Wad::SCALE + 1),
            salt: 7,
        )
}
