#[test(balance = 10_000_000_000_000_000_000)]
fn distributor_claim_multi_pair() uses (evm: mut Evm) {
    let distributor = deploy_tree4(0, 0, 0, ether(5).as_wei())
    let alice = Address::new(0x1111111111111111111111111111111111111111)
    let bob = Address::new(0x2222222222222222222222222222222222222222)
    // Multiproof for leaves [0, 1]: one proof node, flags [true, false].
    let proof = words(
        [0x04d015752dc2e032305c43ea9f20ffae4dcb3a7e3f8bfdaa4d095965f9c2b28f],
    )
    let total: u256 = evm
        .call(
            addr: distributor,
            gas: 500000,
            value: Wei::zero(),
            message: DistributorMsg::ClaimMulti {
                proof: proof_to_dynarray(proof),
                proof_flags: bools_dyn([true, false]),
                indices: proof_to_dynarray(words([0, 1])),
                accounts: addrs_dyn([alice, bob]),
                amounts: proof_to_dynarray(words([250000000000000000, 500000000000007919])),
            },
        )
    assert!(total == 750000000000007919)
    assert!(evm.balance(alice) == wei(250000000000000000))
    assert!(evm.balance(bob) == wei(500000000000007919))
    let claimed1: bool = evm
        .call(
            addr: distributor,
            gas: 100000,
            value: Wei::zero(),
            message: DistributorMsg::IsClaimed { index: 1 },
        )
    assert!(claimed1)
}

#[test(balance = 10_000_000_000_000_000_000)]
fn distributor_claim_multi_all() uses (evm: mut Evm) {
    let distributor = deploy_tree4(0, 0, 0, ether(5).as_wei())
    let accounts = addrs_dyn(
        [
            Address::new(0x1111111111111111111111111111111111111111),
            Address::new(0x2222222222222222222222222222222222222222),
            Address::new(0x3333333333333333333333333333333333333333),
            Address::new(0x4444444444444444444444444444444444444444),
        ],
    )
    // All four leaves: empty proof, flags [true, true, true].
    let total: u256 = evm
        .call(
            addr: distributor,
            gas: 500000,
            value: Wei::zero(),
            message: DistributorMsg::ClaimMulti {
                proof: proof_to_dynarray(empty_words()),
                proof_flags: bools_dyn([true, true, true]),
                indices: proof_to_dynarray(words([0, 1, 2, 3])),
                accounts: accounts,
                amounts: proof_to_dynarray(
                    words(
                        [
                            250000000000000000,
                            500000000000007919,
                            750000000000015838,
                            1000000000000023757,
                        ],
                    ),
                ),
            },
        )
    assert!(total == 2500000000000047514)
    let stored: u256 = evm
        .call(
            addr: distributor,
            gas: 100000,
            value: Wei::zero(),
            message: DistributorMsg::TotalClaimed {},
        )
    assert!(stored == 2500000000000047514)
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn distributor_claim_multi_bad_flags_reverts() uses (evm: mut Evm) {
    let distributor = deploy_tree4(0, 0, 0, ether(5).as_wei())
    let alice = Address::new(0x1111111111111111111111111111111111111111)
    let bob = Address::new(0x2222222222222222222222222222222222222222)
    // Flags [true, true] with one proof node: the second flag consumes a
    // queue item that does not exist, so the multiproof walk reverts.
    let proof = words(
        [0x04d015752dc2e032305c43ea9f20ffae4dcb3a7e3f8bfdaa4d095965f9c2b28f],
    )
    let _: u256 = evm
        .call(
            addr: distributor,
            gas: 500000,
            value: Wei::zero(),
            message: DistributorMsg::ClaimMulti {
                proof: proof_to_dynarray(proof),
                proof_flags: bools_dyn([true, true]),
                indices: proof_to_dynarray(words([0, 1])),
                accounts: addrs_dyn([alice, bob]),
                amounts: proof_to_dynarray(words([250000000000000000, 500000000000007919])),
            },
        )
}

#[test(balance = 10_000_000_000_000_000_000)]
fn distributor_fee_exact() uses (evm: mut Evm) {
    // Degenerate window (end <= start) forces vesting fraction 1 whatever
    // the block timestamp is; a 25% fee must leave exactly 75%.
    let distributor = deploy_tree4(100, 100, 250000000000000000, ether(5).as_wei())
    let alice = Address::new(0x1111111111111111111111111111111111111111)
    let proof = words(
        [
            0x647dc7437e02fd27e50f72e3bb9edfb29349b80dba3beb9399e592eec7e26b50,
            0x04d015752dc2e032305c43ea9f20ffae4dcb3a7e3f8bfdaa4d095965f9c2b28f,
        ],
    )
    let payout: u256 = evm
        .call(
            addr: distributor,
            gas: 300000,
            value: Wei::zero(),
            message: DistributorMsg::Claim {
                proof: proof_to_dynarray(proof),
                index: 0,
                account: alice,
                amount: 250000000000000000,
            },
        )
    assert!(payout == 187500000000000000)
}

#[test(balance = 10_000_000_000_000_000_000)]
fn distributor_zero_vesting() uses (evm: mut Evm) {
    // Window end 2^200: the fraction is exactly 0 for any realistic block
    // timestamp, so the claim pays 0 but still marks the index claimed.
    let distributor = deploy_tree4(0, 2 ** 200, 0, ether(5).as_wei())
    let alice = Address::new(0x1111111111111111111111111111111111111111)
    let proof = words(
        [
            0x647dc7437e02fd27e50f72e3bb9edfb29349b80dba3beb9399e592eec7e26b50,
            0x04d015752dc2e032305c43ea9f20ffae4dcb3a7e3f8bfdaa4d095965f9c2b28f,
        ],
    )
    let payout: u256 = evm
        .call(
            addr: distributor,
            gas: 300000,
            value: Wei::zero(),
            message: DistributorMsg::Claim {
                proof: proof_to_dynarray(proof),
                index: 0,
                account: alice,
                amount: 250000000000000000,
            },
        )
    assert!(payout == 0)
    let claimed: bool = evm
        .call(
            addr: distributor,
            gas: 100000,
            value: Wei::zero(),
            message: DistributorMsg::IsClaimed { index: 0 },
        )
    assert!(claimed)
}

#[test(balance = 10_000_000_000_000_000_000)]
fn distributor_partial_vesting_exact() uses (evm: mut Evm) {
    // Window [0, 10^12): the harness timestamp is strictly inside it, so
    // the fraction is strictly partial. The test reads the fraction from
    // the contract, recomputes the payout with plain u256 arithmetic, and
    // asserts the claim pays exactly that. Timestamp stability within a
    // test is pinned by distributor_timestamp_stable_within_test.
    let distributor = deploy_tree4(0, 1_000_000_000_000, 0, ether(5).as_wei())
    let fraction: u256 = evm
        .call(
            addr: distributor,
            gas: 100000,
            value: Wei::zero(),
            message: DistributorMsg::VestedFraction {},
        )
    assert!(fraction > 0)
    assert!(fraction < Wad::SCALE)
    let expected = (250000000000000000 * fraction) / Wad::SCALE
    let alice = Address::new(0x1111111111111111111111111111111111111111)
    let proof = words(
        [
            0x647dc7437e02fd27e50f72e3bb9edfb29349b80dba3beb9399e592eec7e26b50,
            0x04d015752dc2e032305c43ea9f20ffae4dcb3a7e3f8bfdaa4d095965f9c2b28f,
        ],
    )
    let payout: u256 = evm
        .call(
            addr: distributor,
            gas: 300000,
            value: Wei::zero(),
            message: DistributorMsg::Claim {
                proof: proof_to_dynarray(proof),
                index: 0,
                account: alice,
                amount: 250000000000000000,
            },
        )
    assert!(payout == expected)
    assert!(payout > 0)
    assert!(payout < 250000000000000000)
}

