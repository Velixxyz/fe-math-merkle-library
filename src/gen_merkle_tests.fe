#[test]
fn mp_16_subset_0() {
    let proof = w(
        [
            0x647dc7437e02fd27e50f72e3bb9edfb29349b80dba3beb9399e592eec7e26b50,
            0x04d015752dc2e032305c43ea9f20ffae4dcb3a7e3f8bfdaa4d095965f9c2b28f,
            0xea42fba130553e1dfd976eac009b74163725a53fdfb22d6b00746d1bdc980f32,
            0x2a4804e422a458f76a691621b3ae9fff0c731f394c243a9ee0577e948260806f,
        ],
    )
    let flags = w([0, 0, 0, 0])
    let leaves = w(
        [0xe0afe6df674ec998ece90d140c5916b331289a76c258163da083e5c1c6403f7b],
    )
    assert!(
        multiproof::verify_multi_proof(
            proof: proof,
            proof_flags: flags,
            root: 0xda2acf4c1b7fd8a3065bef79887c1d89bbd32b0f915b266950292d64394d0154,
            leaves: leaves,
        ),
    )
    assert!(
        multiproof::process_multi_proof(proof: proof, proof_flags: flags, leaves: leaves)
            == 0xda2acf4c1b7fd8a3065bef79887c1d89bbd32b0f915b266950292d64394d0154,
    )
}

