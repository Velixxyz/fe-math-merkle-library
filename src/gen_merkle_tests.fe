use core::ptr::{self, MemSlice}
use ingot::multiproof::{self, leaf_from_words}
use std::evm::merkle

fn w<const N: usize>(_ values: [u256; N]) -> ref MemSlice<u256> {
    var array = unsafe {
        ptr::alloc_array<u256>(N)
    }
    var i: usize = 0
    for value in values {
        array[i] = value
        i += 1
    }
    array.as_slice()
}

